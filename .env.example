# Environment Variables for Promptions Chat
# Copy this file to .env and fill in the values

# ============================================
# Frontend Keys (VITE_ prefix for client-side)
# ============================================

# Gemini API Key (fallback)
VITE_GEMINI_API_KEY=your-gemini-api-key

# OpenAI API Key (fallback)
VITE_OPENAI_API_KEY=your-openai-api-key

# Phi-4 Azure AI (Primary)
VITE_PHI4_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/
VITE_PHI4_API_KEY=your-azure-phi4-api-key

# ============================================
# Backend Keys (Server-side only)
# ============================================

# Azure OpenAI (o4-mini) - Primary Chat
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT=o4-mini

# Azure AI (Phi-4-reasoning) - Deep Thinking
AZURE_PHI4_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/
AZURE_PHI4_API_KEY=your-azure-phi4-api-key
AZURE_PHI4_DEPLOYMENT=Phi-4-reasoning

# MongoDB
MONGODB_URI=mongodb+srv://user:password@clusterq.xxxxx.mongodb.net
MONGODB_DB_NAME=nextprompt

# ============================================
# Optional: Flux.2-pro (Day 3)
# ============================================
# FLUX_API_ENDPOINT=https://your-flux-endpoint
# FLUX_API_KEY=your-flux-api-key
